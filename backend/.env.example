# ShopBot configuration. Copy to .env and fill in. Never commit .env.
#
# LLM_PROVIDER selects the model backend. "ollama" needs no API key and
# costs nothing (Book 1, Ch. 2 "Free Alternative"). "openai" matches the
# book's primary path and costs approximately ₹7.60 total for the Book 1
# build (Ch. 10) but requires a funded OpenAI account.
LLM_PROVIDER=ollama

# --- OpenAI path (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Ollama path (LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# --- Retrieval tuning (Ch. 6) ---
# 0.75 is the book's own number, calibrated against its 5-product demo
# catalog. Re-run scripts/calibrate_threshold.py against your real catalog
# before trusting this value — this build's 50-product catalog calibrated
# to 0.62 instead (see docs/evidence/2026-10-14_threshold-calibration.txt).
SIMILARITY_THRESHOLD=0.75
MAX_RETRIEVED_CHUNKS=3

# --- Storage ---
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=zudyog_products

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=20
